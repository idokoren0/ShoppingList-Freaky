# Copy to ".env" if you want to set any of these. Everything here is optional:
# the app's first-run setup screen asks for the language, currency, household and OpenAI key.

# Your time zone, so "today" and the nightly backup follow your clock (e.g. Europe/London, America/New_York)
TZ=UTC

# Port on this machine, and which address to listen on.
# 127.0.0.1 = only this machine (use with Tailscale Serve or a reverse proxy); 0.0.0.0 = your whole network.
PORT=8080
BIND_ADDR=0.0.0.0

# OpenAI API key for reading receipts, handwritten notes and recipe links.
# Set here, it overrides the key typed into the app's Settings and can't be changed from a phone.
# Get one at https://platform.openai.com/api-keys (billed separately from a ChatGPT subscription).
OPENAI_API_KEY=

# Models (any OpenAI model that accepts images). Defaults: gpt-4.1-mini and gpt-6.1-terra.
OPENAI_MODEL=
OPENAI_MODEL_STRONG=

# Picture model for the purchase monsters. Defaults: gpt-image-2 at medium quality (about $0.05 a picture).
# gpt-image-1-mini is about $0.01 and simpler; quality can be low, medium or high.
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=

# Days to keep the access log
LOG_KEEP_DAYS=90
